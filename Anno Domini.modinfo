<?xml version="1.0" encoding="utf-8"?>
<Mod id="anno_domini" version="3"
	xmlns="ModInfo">
	<Properties>
		<Name>Anno Domini</Name>
		<Description>Use AD and BC.</Description>
		<Authors>Robert Domico</Authors>
		<Package>Mod</Package>
		<AffectsSavedGames>0</AffectsSavedGames>
	</Properties>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>	
	<ActionGroups>
		<ActionGroup id="anno_domini" scope="game" criteria="always">
			<Properties>
				<LoadOrder>9999</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>	
					<Item>text/CivilopediaUpdates.sql</Item>			
					<Item>text/CalendarTextOverride.sql</Item>
					<Item>text/CalendarTextOverride_FR.sql</Item>			
				</UpdateText>

			</Actions>
		</ActionGroup>
	</ActionGroups>

</Mod>
